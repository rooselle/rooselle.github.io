{
  "name": "rooselle",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node_modules/.bin/tailwindcss -i ./src/css/theme.css -o ./dist/css/theme.css && npx @11ty/eleventy",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "serve": "node_modules/.bin/concurrently 'node_modules/.bin/tailwindcss -i ./src/css/theme.css -o ./dist/css/theme.css --watch' 'npx @11ty/eleventy --serve'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^10.0.3",
    "husky": "^9.1.1",
    "tailwindcss": "^4.3.0"
  }
}
